# ── Terra Server ─────────────────────────────────────────────────────────
# Copy/rename this file to `.env` and adjust values. Loaded via godotenv by
# `internal/config/config.go`. This file contains secrets — do NOT commit.

# ── Server ───────────────────────────────────────────────────────────────────────

# Port the HTTP server binds to.
TERRA_PORT=8080

# Bind address. Use 127.0.0.1 for local-only, 0.0.0.0 to expose on the network.
TERRA_HOST=0.0.0.0

# Database connection string. SQLite is for local development only.
#   SQLite (dev):       sqlite://terra.db
#   PostgreSQL (prod):  postgres://user:pass@host:5432/terra?sslmode=require
# GORM AutoMigrate runs on startup — no manual migrations needed.
# Inside Docker, a relative SQLite path resolves to /data/terra.db on the
# compose volume. Prefer an explicit postgres:// URL in production.
DATABASE_URL=sqlite://terra.db

# ── Auth / JWT ────────────────────────────────────────────────────────────────────

# REQUIRED. Secret used to sign JWT access tokens. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Lifetime of access tokens. Go duration format (s/m/h).
JWT_EXPIRY=15m

# Lifetime of refresh tokens. Default is 720h = 30 days.
REFRESH_TOKEN_EXPIRY=720h

# Public URL the app is reachable at — used for OAuth callback URLs.
BASE_URL=http://localhost:8080

# ── Rate limiting ─────────────────────────────────────────────────────────────────

# Requests per minute allowed to register/login endpoints.
RATE_LIMIT_AUTH=10

# Requests per minute allowed to general API (sync/refresh) endpoints.
RATE_LIMIT_API=30

# ── Reverse proxy ─────────────────────────────────────────────────────────────────

# Comma-separated list of CIDRs trusted to send X-Forwarded-For headers.
# Leave empty if the server is exposed directly (no proxy).
TRUSTED_PROXIES=

# ── CORS ───────────────────────────────────────────────────────────────────────────

# Comma-separated list of browser origins allowed to call the API. Requests
# with an Origin header not in this list are rejected with 403. Desktop app
# webview origins and dev server are allowed by default.
CORS_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://tauri.localhost,tauri://localhost

# ── OAuth (optional) ─────────────────────────────────────────────────────────────

# Google OAuth client credentials (empty = Google login disabled).
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub OAuth client credentials (empty = GitHub login disabled).
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Base URL used to build OAuth redirect callbacks. Defaults to BASE_URL.
OAUTH_REDIRECT_BASE=

# App-scheme fallback for OAuth flows that do not use an allowlisted loopback URI.
# The current Terra desktop flow uses loopback callbacks.
TERRA_APP_SCHEME=terra

# Allowlist of desktop app loopback callback URIs (comma-separated). During
# OAuth the client binds 127.0.0.1 on one of these ports and the server only
# redirects to URIs listed here (mismatch = 400 INVALID_CALLBACK).
# If you change ports here, the client's Rust listener ports
# (client/src-tauri/src/oauth.rs) must match.
TERRA_OAUTH_REDIRECT_URIS=http://127.0.0.1:1421/oauth/callback,http://127.0.0.1:1422/oauth/callback,http://127.0.0.1:1423/oauth/callback

# ── Email verification (optional) ────────────────────────────────────────────

# Require new email/password signups to verify their email with a 6-digit OTP.
# Accepted values: true / 1 / yes. Off by default.
REQUIRE_EMAIL_VERIFICATION=false

# SMTP server for sending verification emails. When REQUIRE_EMAIL_VERIFICATION
# is on, the server REFUSES TO START if SMTP_HOST is empty unless LOG_OTP_FALLBACK
# is explicitly enabled below.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# DEV ONLY — logs verification codes to the server console when SMTP is not
# configured. Never enable this in production: codes would be written to
# stdout logs. Off by default (fail closed).
LOG_OTP_FALLBACK=false

# ── Redis (optional, multi-instance) ─────────────────────────────────────────────

# Redis URL for token/session storage when running multiple server instances.
# Leave empty to use in-memory storage (single instance).
REDIS_URL=

# ── Docker Compose (docker-compose.yml) ──────────────────────────────────────────

# Host-side port and bind address. The container always listens on 8080.
# Set TERRA_BIND_IP=127.0.0.1 when a reverse proxy on the host terminates TLS.
TERRA_HTTP_PORT=8080
TERRA_BIND_IP=0.0.0.0

# Image tag applied when building or pulling ghcr.io/nhridoy/terra-server.
TERRA_IMAGE_TAG=latest
